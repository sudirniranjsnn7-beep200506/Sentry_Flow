# FlowSentry — .env.example
# Copy this file to .env (git-ignored) and fill in machine-specific values.
# Never commit .env to git.
# TRD §25, FR-012

# Path to the raw dataset directory (overrides config/default.yaml paths.data_raw)
# FLOWSENTRY_DATA_DIR=C:/path/to/data/raw

# Path to the artifacts output directory (overrides config/default.yaml paths.artifacts)
# FLOWSENTRY_ARTIFACTS_DIR=C:/path/to/artifacts

# CICFlowMeter command / path — filled at CN-013 after real verification (G-CFM gate)
# CICFLOWMETER_PATH=

# Network interface for live capture — filled at CN-016 after verification
# CAPTURE_INTERFACE=
